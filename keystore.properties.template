# 签名配置模板：复制为 keystore.properties 并填入真实值。
# keystore.properties 已被 .gitignore 排除，不得提交、不得放入分发包。
# 也可用环境变量 CATCATCH_STORE_FILE / CATCATCH_STORE_PASSWORD /
# CATCATCH_KEY_ALIAS / CATCATCH_KEY_PASSWORD 替代本文件。

# keystore 文件路径（相对项目根目录或绝对路径）
storeFile=../你的keystore文件.keystore
# 密钥库密码（在此填入你自己的强密码，勿使用任何历史密码）
storePassword=在此填入密钥库密码
# 密钥别名
keyAlias=在此填入密钥别名
# 密钥密码
keyPassword=在此填入密钥密码
